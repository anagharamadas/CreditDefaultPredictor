# Data — never committed (see data/README.md for the integrity manifest).
# Raw files under data/raw/ are DVC-tracked: DVC maintains per-directory
# .gitignore entries for the data itself; the small .dvc pointer files ARE committed.
data/interim/
data/processed/

# OS
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# Secrets / local config — .env.example is the committed template
.env

# Tooling state
# .mlflow/ is the compose-mounted mlflow backend + artifact store
.mlflow/
# mlruns/ and mlflow.db appear only when a client forgets the tracking URI and
# falls back to local storage (see registry._point_at_the_project_server)
mlruns/
mlflow.db
mlartifacts/
.dvc/cache
