# Copy to .env for `docker compose up`. LOCAL DEVELOPMENT VALUES ONLY —
# .env is gitignored; a real deployment supplies these from a secret store.
# Every value below also has a compose-file default, so the stack runs without
# a .env at all; this file documents what is configurable.

# --- prediction store (P8 #47) ---
POSTGRES_USER=credit
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=predictions
POSTGRES_PORT=5432

# --- tracking ---
# Inside the compose network the API reaches the server by service name.
# On the host, use http://127.0.0.1:5001 (5000 is taken by macOS AirPlay).
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_PORT=5001

# --- api ---
API_PORT=8000
# Which registry alias the service serves. Promotion (P11) moves the alias;
# the service does not change.
MODEL_ALIAS=champion
# How often a running service re-checks which version that alias points at
# (ADR-0006). This is the rollback latency budget: an alias move takes effect
# within this many seconds, with no restart. 0 pins the replica to the version it
# started with — useful when reproducing a past decision, visible on /ready.
MODEL_REFRESH_SECONDS=30
